# Public broker used by the ESP32 test firmware.
MQTT_BROKER_HOST=test.mosquitto.org
MQTT_BROKER_PORT=1883
# Includes telemetry, retained geofence snapshots, and geofence events.
MQTT_TOPIC=djua/test/+/#

# Set these when moving to an authenticated MQTT broker.
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Number of messages retained in memory per running API instance.
TELEMETRY_HISTORY_LIMIT=500
